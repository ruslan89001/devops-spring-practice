{% extends 'base.html.twig' %}

{% block title %}Управление бронированиями{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Управление бронированиями</h1>

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Пользователь</th>
                    <th>Пространство</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Создано</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for booking in bookings %}
                    <tr>
                        <td>{{ booking.id }}</td>
                        <td>{{ booking.user.name }}</td>
                        <td>
                            <a href="{{ path('app_space_show', {id: booking.space.id}) }}">
                                {{ booking.space.name }}
                            </a>
                        </td>
                        <td>{{ booking.bookingDate|date('d.m.Y') }}</td>
                        <td>
                            {% if booking.status == 'active' %}
                                <span class="badge bg-success">Активно</span>
                            {% else %}
                                <span class="badge bg-secondary">Отменено</span>
                            {% endif %}
                        </td>
                        <td>{{ booking.createdAt|date('d.m.Y H:i') }}</td>
                        <td>
                            {% if booking.status == 'active' %}
                                <form method="post" action="{{ path('app_admin_booking_cancel', {id: booking.id}) }}" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Отменить бронирование?')">
                                        <i class="fas fa-ban"></i> Отменить
                                    </button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('app_admin_booking_delete', {id: booking.id}) }}" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить бронирование?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">Нет бронирований</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
