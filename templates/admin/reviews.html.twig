{% extends 'base.html.twig' %}

{% block title %}Управление отзывами{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Управление отзывами</h1>

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Пользователь</th>
                    <th>Пространство</th>
                    <th>Рейтинг</th>
                    <th>Комментарий</th>
                    <th>Дата</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody>
                {% for review in reviews %}
                    <tr>
                        <td>{{ review.id }}</td>
                        <td>{{ review.user.name }}</td>
                        <td>
                            <a href="{{ path('app_space_show', {id: review.space.id}) }}">
                                {{ review.space.name }}
                            </a>
                        </td>
                        <td>
                            <span class="text-warning">
                                {% for i in 1..5 %}
                                    <i class="fas fa-star{% if i > review.rating %}-o{% endif %}"></i>
                                {% endfor %}
                            </span>
                        </td>
                        <td>{{ review.comment|slice(0, 50) }}{% if review.comment|length > 50 %}...{% endif %}</td>
                        <td>{{ review.createdAt|date('d.m.Y H:i') }}</td>
                        <td>
                            <form method="post" action="{{ path('app_admin_review_delete', {id: review.id}) }}" style="display:inline;" onsubmit="return confirm('Удалить отзыв?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">Нет отзывов</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
