{% extends 'base.html.twig' %}

{% block title %}Админ-панель{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Панель администратора</h1>

        <div class="row">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Пользователи</h5>
                        <h2>{{ stats.total_users }}</h2>
                        <a href="{{ path('app_admin_users') }}" class="btn btn-light btn-sm">Управление</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Пространства</h5>
                        <h2>{{ stats.total_spaces }}</h2>
                        <a href="{{ path('app_admin_spaces') }}" class="btn btn-light btn-sm">Управление</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Бронирования</h5>
                        <h2>{{ stats.total_bookings }}</h2>
                        <a href="{{ path('app_admin_bookings') }}" class="btn btn-light btn-sm">Управление</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Отзывы</h5>
                        <h2>{{ stats.total_reviews }}</h2>
                        <a href="{{ path('app_admin_reviews') }}" class="btn btn-light btn-sm">Управление</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
