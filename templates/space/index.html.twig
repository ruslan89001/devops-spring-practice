{% extends 'base.html.twig' %}

{% block title %}Каталог пространств{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Каталог коворкинг-пространств</h1>

        <div class="row">
            {% for space in spaces %}
                <div class="col-md-4 mb-4">
                    <div class="card space-card h-100 d-flex flex-column">
                        {% if space.photo %}
                            <img src="{{ asset('uploads/spaces/' ~ space.photo) }}" class="card-img-top" alt="{{ space.name }}" style="height: 200px; object-fit: cover;">
                        {% else %}
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-building fa-3x text-white"></i>
                            </div>
                        {% endif %}

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ space.name }}</h5>
                            <p class="card-text text-muted">
                                <i class="fas fa-map-marker-alt"></i> {{ space.address }}
                            </p>
                            <p class="card-text flex-grow-1">{{ space.description|slice(0, 100) }}{% if space.description|length > 100 %}...{% endif %}</p>

                            <div class="mt-auto">
                                <p class="h5 text-primary mb-3">{{ space.price }} ₽/день</p>
                                <a href="{{ path('app_space_show', {id: space.id}) }}" class="btn btn-primary w-100">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        Пока нет доступных пространств
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
