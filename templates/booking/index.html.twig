{% extends 'base.html.twig' %}

{% block title %}Мои бронирования{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Мои бронирования</h1>

        {% if bookings is empty %}
            <div class="alert alert-info">
                У вас пока нет бронирований. <a href="{{ path('app_spaces') }}">Посмотреть пространства</a>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>Пространство</th>
                        <th>Адрес</th>
                        <th>Дата</th>
                        <th>Цена</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for booking in bookings %}
                        <tr data-booking-id="{{ booking.id }}">
                            <td>
                                <a href="{{ path('app_space_show', {id: booking.space.id}) }}">
                                    {{ booking.space.name }}
                                </a>
                            </td>
                            <td>{{ booking.space.address }}</td>
                            <td>{{ booking.bookingDate|date('d.m.Y') }}</td>
                            <td>{{ booking.space.price }} ₽</td>
                            <td>
                                {% if booking.status == 'active' %}
                                    <span class="badge bg-success">Активно</span>
                                {% else %}
                                    <span class="badge bg-secondary">Отменено</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if booking.status == 'active' %}
                                    <button class="btn btn-sm btn-danger cancel-booking" data-booking-id="{{ booking.id }}">
                                        <i class="fas fa-times"></i> Отменить
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/booking.js') }}"></script>
{% endblock %}
